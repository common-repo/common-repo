-- allium: 3
-- detailed/auto-merge-composition.allium
--
-- Scope: Auto-merge behaviour during Phase 4 composite construction
-- Includes: Cross-repo auto-merge file merging, deferred merge collection
-- Excludes: Individual merge format semantics (see merge-operations.allium)
--
-- Context: When chained upstream repos both declare auto-merge for the same
-- file, the composite must contain the merged combination of all upstream
-- contributions — not just the last repo's version.
--
-- Example chain:
--   consumer -> conventional-commits -> pre-commit
--   Both declare: yaml: { auto-merge: .pre-commit-config.yaml }
--   Both provide src/.pre-commit-config.yaml (renamed to .pre-commit-config.yaml)
--   Consumer expects combined repos: entries from both upstreams.

-- ==========================================================================
-- Entities
-- ==========================================================================

-- Tracks which files have pending auto-merge declarations during composition
value AutoMergeTarget {
    path: String
    format: YamlMerge | JsonMerge | TomlMerge | IniMerge | MarkdownMerge | XmlMerge
    array_mode: ArrayMergeMode
    position: InsertPosition
}

-- ==========================================================================
-- Rules
-- ==========================================================================

rule AutoMergeInComposite {
    -- @status: Implemented
    when: CompositeFileConflict(composite_fs, incoming_file, repo_key)
    requires: has_auto_merge_for(repo_key, incoming_file.path)

    -- When a file already exists in the composite AND the incoming repo
    -- declares an auto-merge operation targeting that file, perform a
    -- format-aware merge instead of overwriting.
    --
    -- The existing composite content is the "dest" (accumulated result).
    -- The incoming file content is the "source" (new contribution).
    -- The merge uses the parameters from the auto-merge declaration
    -- (array_mode, position, etc.).
    let existing = composite_fs.entry(incoming_file.path)
    let merge_op = auto_merge_operation_for(repo_key, incoming_file.path)
    ensures: MergeApplied(merge_op, existing, incoming_file)

    @guidance
        -- This happens inline during Phase 4 composite construction,
        -- inside the per-repo filesystem merge loop. The check is:
        --   1. Does the composite already have a file at this path?
        --   2. Does the current repo's collected merge_operations include
        --      an auto-merge targeting this path?
        -- If both yes: merge instead of overwrite.
        -- If no auto-merge declared: last-write-wins (existing behaviour).
}

rule NoAutoMergeFallsThrough {
    -- @status: Implemented
    when: CompositeFileConflict(composite_fs, incoming_file, repo_key)
    requires: not has_auto_merge_for(repo_key, incoming_file.path)

    -- Without an auto-merge declaration, the existing last-write-wins
    -- behaviour is preserved. The incoming file overwrites.
    ensures: composite_fs.entry(incoming_file.path).content = incoming_file.content
}

rule AutoMergeChainsAccumulate {
    -- @status: Implemented
    when: CompositeReady(order, intermediate_fss)

    -- When three or more repos in the chain all declare auto-merge for
    -- the same file, merges accumulate left-to-right in operation order.
    --
    -- Example with repos A -> B -> C (post-order: A, B, C):
    --   1. A's file enters composite (no conflict, first occurrence)
    --   2. B's file arrives — auto-merge declared — merge B into A's content
    --   3. C's file arrives — auto-merge declared — merge C into (A+B) content
    --
    -- The final composite contains the combination of all three.
    -- Each merge step uses the declaring repo's merge parameters.

    @guidance
        -- The implementation does not need a separate accumulator.
        -- The composite FS itself serves as the running accumulation.
        -- Each repo's merge operation merges into whatever is already
        -- in the composite at that path.
}

rule DeferredMergeAtDeclarationPosition {
    -- @status: Implemented
    when: ApplyRepoInline(op, parent_composite, sub_composite)

    -- With sequential operation execution, auto-merge operations from
    -- a sub-repo execute at the parent's repo: declaration position
    -- during composite construction — not in a separate Phase 5 batch.
    --
    -- At the repo: declaration point:
    --   1. The sub-composite's files enter the parent composite.
    --   2. For paths that conflict AND have an auto-merge declaration:
    --      format-aware merge fires immediately against the parent
    --      composite (see AutoMergeInComposite).
    --   3. For deferred merge operations whose destination is already
    --      in the parent composite (e.g., local files pulled in by
    --      a preceding include): the merge executes here.
    --   4. For deferred merge operations whose destination is NOT in
    --      the parent composite (local-only files not yet included):
    --      the operation is collected for Phase 5 execution after
    --      the composite is combined with local files.
    --
    -- Cross-upstream auto-merge accumulation (AutoMergeChainsAccumulate)
    -- still works: if the parent composite already has accumulated
    -- content from a prior upstream at the same path, the new sub-repo's
    -- auto-merge merges into that accumulated content.

    @guidance
        -- This replaces the previous model where all deferred ops were
        -- collected during Phase 4 and executed in a single batch
        -- during Phase 5.
        --
        -- The key benefit: in a self: block where include operators
        -- pull local files into the composite before a repo: fires,
        -- the auto-merge can see the local content at merge time.
        -- This fixes the bug where consumer filters destroyed auto-
        -- merged content because merges and filters did not interleave.
        --
        -- Auto-merge operations that were resolved during cross-
        -- upstream composition (step 2 above) should NOT re-execute
        -- at the repo: position — the cross-upstream merge is already
        -- done. Only the consumer-facing deferred merge (step 3-4)
        -- remains.
}

-- ==========================================================================
-- Declaration precedence and cancellation (issue #383)
-- ==========================================================================

rule NearestDeclarationWins {
    -- @status: Implemented
    when: AutoMergeDeclarationsCollected(declarations, path)

    -- When more than one repository along the chain declares an
    -- auto-merge for the same path, the declaration nearest the consumer
    -- decides the merge: the integrating repo's own declaration first,
    -- then its upstreams', nearest first. Among sibling repo: entries,
    -- the later sibling wins.
    --
    -- The merge_operations list is built nearest-first (own declarations
    -- before inherited ones), so collecting by path keeps the first
    -- entry rather than the last.
    ensures: auto_merge_operation_for(path) = nearest(declarations, path)

    @guidance
        -- A duplicate whose parameters differ is announced at default
        -- visibility (warn), naming the path, the declaration in use,
        -- and the discarded one. Identical duplicates collapse silently.
        -- Before #383 the farthest upstream's declaration won silently.
}

rule ExcludeCancelsUpstreamDeclarations {
    -- @status: Implemented
    when: ExcludeApplied(exclude_op, composite_fs)

    -- A repository that excludes a path owns that path: every inherited
    -- auto-merge declaration whose path matches the exclude's patterns
    -- is cancelled, together with the Phase 5 content snapshot taken for
    -- it. No deferred merge runs on the excluding repository's copy.
    --
    -- Written order decides what an exclude cancels: declarations
    -- collected before the exclude runs (the upstream's own declarations
    -- plus everything integrated earlier in the operation list). An
    -- exclude integrated before a declaration (an upstream's own
    -- filtering operators run before its declarations are collected)
    -- cancels nothing of its own.
    requires: for all d in collected_declarations:
        matches(exclude_op.patterns, d.path) implies cancelled(d)

    @guidance
        -- Holds at every level of the chain:
        --   - a consumer-side top-level exclude after the repo: entry
        --     keeps the consumer's local file untouched;
        --   - an intermediate's with: exclude stops the upstream's
        --     declaration from reaching the intermediate's consumers,
        --     so the intermediate's own file propagates as a plain copy
        --     unless it declares its own merge (which then wins under
        --     NearestDeclarationWins).
        -- Explicit defer: true source/dest operations are a separate
        -- mechanism keyed on dest, not on a declared auto-merge path,
        -- and are never cancelled by this rule.
}

-- ==========================================================================
-- Invariants
-- ==========================================================================

invariant AutoMergePreservesAllContributions {
    -- @status: Implemented
    -- When N upstream repos in a chain all declare auto-merge for the
    -- same file and all provide content for that file, the composite
    -- contains merged content from all N repos.
    --
    -- No upstream's contribution is silently dropped by last-write-wins.
}

invariant AutoMergeOrderDeterministic {
    -- @status: Implemented
    -- Auto-merge composition follows the same operation order as
    -- regular composition (depth-first post-order). The merge result
    -- is deterministic for a given configuration.
}

invariant NonAutoMergeUnchanged {
    -- @status: Implemented
    -- Files without auto-merge declarations continue to use
    -- last-write-wins. This change does not affect files that
    -- are not targets of auto-merge operations.
}
