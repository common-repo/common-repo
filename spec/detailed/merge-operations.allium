-- allium: 2
-- detailed/merge-operations.allium
--
-- Scope: Merge operation semantics for structured and text file formats
-- Includes: YAML, JSON, TOML, INI, Markdown, and XML merge behavior,
--           path navigation, array handling, conflict resolution
-- Excludes:
--   - Config parsing and validation (see common-repo.allium)
--   - Pipeline orchestration and merge timing (see common-repo.allium)
--   - File I/O and encoding (treated as infrastructure)

-- ==========================================================================
-- Value Types
-- ==========================================================================

value MergePath {
    -- Dot-separated keys with optional bracket notation.
    -- Examples: "foo.bar.baz", "foo[\"special.key\"]", "items[0]"
    raw: String
    segments: List<PathSegment>
}

value PathSegment {
    kind: key | index
    value: String
}

-- ==========================================================================
-- Enumerations
-- ==========================================================================

-- ArrayMergeMode and InsertPosition enums are declared in common-repo.allium

-- ==========================================================================
-- Cross-Cutting Rules
-- ==========================================================================

-- --------------------------------------------------------------------------
-- Destination Auto-Creation
-- --------------------------------------------------------------------------

rule AutoCreateDestination {
    -- @status: Implemented
    when: ApplyMerge(op, filesystem)
    requires: not filesystem.contains(op.effective_dest)

    -- When the destination file does not exist, create it with a
    -- format-appropriate empty stub so the merge can proceed.
    ensures: filesystem.contains(op.effective_dest)

    @guidance
        -- YAML: created with "---\n" (document marker)
        -- JSON: created with "{}" (empty object)
        -- TOML: created with empty table
        -- INI: created as empty file
        -- Markdown: created as empty file
        -- XML: created with a minimal stub containing an XML declaration
        --   and a root element whose local name and namespace match the
        --   source document's root element
}

-- --------------------------------------------------------------------------
-- No-Op Write Stability
-- --------------------------------------------------------------------------

rule NoOpMergePreservesBytes {
    -- @status: Implemented
    when: ApplyMerge(op, filesystem)
    requires:
        and destination exists in filesystem
        and merge(op, parse(source), parse(destination)) = parse(destination)

    -- A merge that leaves the destination's parsed content unchanged leaves
    -- its bytes alone: no write occurs. Comments, flow styles, inline
    -- tables, and hand formatting in a file the merge does not change
    -- survive verbatim, apply run twice writes the same bytes both times,
    -- and diff reports no changes right after apply — including for a
    -- freshly copied auto-merge file the consumer has never edited.
    ensures: filesystem.read(op.effective_dest) unchanged by the operation

    @guidance
        -- Applies to the structured formats: yaml, json, toml, ini, xml.
        -- Markdown merges splice text and are not affected.
        -- For xml the comparison is over the canonical serialization of
        -- the destination before and after the merge; text content whose
        -- full value already equals the source's is not reapplied, so
        -- whitespace-only text nodes are not moved around on a no-op.
        -- When content does change, the destination is rewritten in the
        -- operator's canonical format; formatting the writers cannot
        -- represent (comments, flow styles) is lost on that rewrite.
}

-- --------------------------------------------------------------------------
-- Missing Source Handling
-- --------------------------------------------------------------------------

rule MissingSourceExplicit {
    -- @status: Implemented
    when: ApplyMerge(op, filesystem)
    requires: op.source != null
    requires: op.auto_merge = null
    requires: not filesystem.contains(op.effective_source)

    -- Explicit source/dest: missing source is an error.
    ensures: Error(message: "File not found in filesystem")

    @guidance
        -- With sequential operation execution, a preceding exclude or
        -- rename may have removed or relocated the source file. The
        -- error message should include a hint: "Was the source possibly
        -- renamed or excluded by a preceding operation?" to aid
        -- debugging declaration-order issues.
}

rule MissingSourceAutoMerge {
    -- @status: Implemented
    when: ApplyMerge(op, filesystem)
    requires: op.auto_merge != null
    requires: not filesystem.contains(op.effective_source)
    requires: not filesystem.contains(op.effective_dest)

    -- Auto-merge where neither side has the file: warn and skip.
    ensures: Warning(message: "Auto-merge skipped, file not found on either side")

    @guidance
        -- Auto-merge expresses intent to "merge if present." When neither
        -- the source nor destination exists, there is nothing to merge.
        -- This is a warning, not an error, because auto-merge is a
        -- best-effort directive.
        --
        -- With sequential operation execution, a preceding exclude or
        -- rename may have removed or relocated the file. The warning
        -- message should include a hint: "Was the source possibly
        -- renamed or excluded by a preceding operation?"
}

-- --------------------------------------------------------------------------
-- Path Navigation
-- --------------------------------------------------------------------------

rule NavigatePath {
    -- @status: Implemented
    when: ApplyStructuredMerge(op, dest_value, path)
    requires: path.segments.count > 0

    -- Navigate into the destination structure following path segments.
    -- Auto-create intermediate containers (objects/tables/mappings) for
    -- missing keys. Auto-extend arrays for out-of-bounds indices.
    ensures: PathResolved(dest_value, path)
}

rule PathThroughScalar {
    -- @status: Implemented
    when: NavigatePath(dest_value, path, current_segment)
    requires: current_segment.kind = key
    requires: is_scalar(current_value)

    -- Cannot traverse through a scalar value. Navigating path "foo.bar"
    -- when "foo" is an integer or string is an error — replacing it
    -- silently would destroy data.
    ensures: Error(message: "Cannot navigate through scalar value")
}

-- --------------------------------------------------------------------------
-- Array Merge Semantics (Unified Model)
-- --------------------------------------------------------------------------

rule ArrayReplace {
    -- @status: Implemented
    when: MergeArrays(source, dest, mode, position)
    requires: mode = replace

    -- Replace destination array entirely with source array.
    ensures: result = source
}

rule ArrayAppend {
    -- @status: Implemented
    when: MergeArrays(source, dest, mode, position)
    requires: mode = append

    ensures:
        if position = start:
            result = source + dest
        else:
            result = dest + source
}

rule ArrayAppendUnique {
    -- @status: Implemented
    when: MergeArrays(source, dest, mode, position)
    requires: mode = append_unique

    -- Add only source items not already present in destination.
    let unique_items = source where item not in dest
    ensures:
        if position = start:
            result = unique_items + dest
        else:
            result = dest + unique_items

    @guidance
        -- Presence is tested by whole-item equality. An upstream edit to an
        -- existing item therefore counts as "new": the edited item is
        -- appended next to the stale copy (issue #370). Arrays whose items
        -- have identity should use merge_by_key instead.
}

rule ArrayMergeByKey {
    -- @status: Implemented
    when: MergeArrays(source, dest, mode, position, key)
    requires: mode = merge_by_key

    -- Match items by a key field; a matched destination item is replaced in
    -- place with the source item. Unmatched and keyless behavior below.
    let detected_key(item) = first_present(item, key ?? [name, uses, id])
    ensures:
        for item in source:
            if detected_key(item) != null:
                if any dst in dest where dst[key] = item[key]:
                    result replaces that dst with item, in place
                else:
                    item is new
            else:
                -- Keyless items keep append_unique semantics.
                item is new only if item not in dest
        if position = start:
            new items are inserted before dest
        else:
            new items are appended after dest
    ensures: every dest item not matched by any source item is preserved
    ensures: result is a fixed point of the merge (idempotent)

    @guidance
        -- XML resolves keys on attributes: key ?? [name, id]. XML items
        -- without a key attribute fall back to text-content uniqueness.
        -- The key field is chosen from the SOURCE item; a destination item
        -- matches when it carries the same field with an equal value. Keys
        -- should be unique within an array; duplicate keys consume
        -- destination items in order.
        --
        -- Across tiers the pipeline decides which side is the source. A
        -- file a repo includes itself is merged with its upstream's copy
        -- as the source first (own order kept, upstream-only items added)
        -- and then with its own copy as the source, so its own versions of
        -- matched items win. See ApplyDeferredMerges in common-repo.allium
        -- for the full precedence list.
}

-- --------------------------------------------------------------------------
-- Type Mismatch Resolution
-- --------------------------------------------------------------------------

rule TypeMismatchReplace {
    -- @status: Implemented
    when: MergeValues(source, dest)
    requires: type_of(source) != type_of(dest)

    -- Type mismatches always replace with a warning, regardless of
    -- merge mode. The user wrote a merge directive, so the source
    -- content should take effect. Silent skipping would mean the
    -- directive did nothing.
    ensures: result = source
    ensures: Warning(message: "Type mismatch, replacing destination value")
}

-- --------------------------------------------------------------------------
-- Scalar Conflict Resolution
-- --------------------------------------------------------------------------

rule ScalarOverwrite {
    -- @status: Implemented
    when: MergeValues(source, dest)
    requires: is_scalar(source)
    requires: is_scalar(dest)

    -- Scalars are last-write-wins: source overrides destination.
    ensures: result = source
}

-- ==========================================================================
-- YAML Merge Semantics
-- ==========================================================================

rule YamlDeepMerge {
    -- @status: Implemented
    when: ApplyYamlMerge(op, filesystem)

    -- Mappings merge recursively: source keys override destination keys,
    -- destination-only keys are preserved.
    -- Sequences use the unified array merge model (array_mode + position).
    -- Scalars use last-write-wins.
    ensures: YamlMerged(op, filesystem)
}

-- ==========================================================================
-- JSON Merge Semantics
-- ==========================================================================

rule JsonDeepMerge {
    -- @status: Implemented
    when: ApplyJsonMerge(op, filesystem)

    -- Objects merge recursively: source keys override destination keys,
    -- destination-only keys are preserved.
    -- Arrays use the unified array merge model (array_mode + position).
    -- Scalars use last-write-wins.
    ensures: JsonMerged(op, filesystem)

    @guidance
        -- JSON now uses array_mode enum + InsertPosition enum, matching
        -- YAML and TOML. Legacy boolean append field is preserved for
        -- backward-compatible deserialization.
}

-- ==========================================================================
-- TOML Merge Semantics
-- ==========================================================================

rule TomlDeepMerge {
    -- @status: Implemented
    when: ApplyTomlMerge(op, filesystem)

    -- Tables merge recursively: source keys override destination keys,
    -- destination-only keys are preserved.
    -- Arrays use the unified array merge model (array_mode + position).
    -- Scalars use last-write-wins.
    ensures: TomlMerged(op, filesystem)
}

rule TomlCommentPreservation {
    -- @status: Implemented
    when: ApplyTomlMerge(op, filesystem)
    requires: op.preserve_comments = true

    -- When preserve_comments is enabled, the output retains formatting
    -- and comments from the destination file where possible.
    ensures: CommentsPreserved(op, filesystem)

    @guidance
        -- Comment preservation is best-effort. Structural changes
        -- (new keys, removed sections) may displace comments.
}

-- ==========================================================================
-- INI Merge Semantics
-- ==========================================================================

rule IniSectionMerge {
    -- @status: Implemented
    when: ApplyIniMerge(op, filesystem)

    ensures:
        if op.section != null:
            -- Merge source entries into the specified section only.
            IniSectionMerged(op, filesystem, op.section)
        else:
            -- Merge all sections from source into destination.
            IniAllSectionsMerged(op, filesystem)
}

rule IniKeyMatching {
    -- @status: Implemented
    when: IniCheckDuplicate(key, existing_keys)

    -- Key matching is case-insensitive. INI files originate from
    -- Windows where keys are traditionally case-insensitive. This
    -- default ensures cross-platform interoperability.
    ensures: match = existing_keys.any(k => lowercase(k) = lowercase(key))
}

rule IniAppendMode {
    -- @status: Implemented
    when: IniMergeEntries(source_entries, dest_entries, op)
    requires: op.append = true

    ensures:
        if op.allow_duplicates:
            -- Add all source entries regardless of existing keys.
            result = dest_entries + source_entries
        else:
            -- Only add source entries whose keys do not exist in destination.
            let new_entries = source_entries where not IniCheckDuplicate(entry.key, dest_entries.keys)
            result = dest_entries + new_entries
}

rule IniReplaceMode {
    -- @status: Implemented
    when: IniMergeEntries(source_entries, dest_entries, op)
    requires: op.append = false

    ensures:
        if op.allow_duplicates:
            -- Add all source entries without removing existing.
            result = dest_entries + source_entries
        else:
            -- Remove existing keys that match source keys, then add source entries.
            let filtered = dest_entries where not IniCheckDuplicate(entry.key, source_entries.keys)
            result = filtered + source_entries
}

-- ==========================================================================
-- Markdown Merge Semantics
-- ==========================================================================

rule MarkdownFindSection {
    -- @status: Implemented
    when: ApplyMarkdownMerge(op, filesystem)

    -- Find section by first exact, case-sensitive heading match.
    -- Section boundaries: from the heading line to the next heading
    -- of equal or lesser level (or end of file).
    ensures: SectionFound(op, filesystem) or SectionNotFound(op, filesystem)

    @guidance
        -- Matching is plain text, not rendered. A heading "## **Bold**"
        -- does not match section name "Bold". The match compares the
        -- full heading text after the "#" markers and whitespace trim.
        -- When multiple sections share the same heading, the first
        -- match is used.
}

rule MarkdownSectionNotFoundError {
    -- @status: Implemented
    when: SectionNotFound(op, filesystem)
    requires: op.create_section = false

    ensures: Error(message: "Section not found")
}

rule MarkdownCreateSection {
    -- @status: Implemented
    when: SectionNotFound(op, filesystem)
    requires: op.create_section = true

    -- Create the section heading at the specified position in the document.
    ensures: SectionCreated(op, filesystem)

    ensures:
        if op.position = start:
            SectionInsertedAtStart(op, filesystem)
        else:
            SectionAppendedAtEnd(op, filesystem)
}

rule MarkdownReplaceContent {
    -- @status: Implemented
    when: SectionFound(op, filesystem)
    requires: op.append = false

    -- Replace all content between the section heading and the next
    -- heading of equal or lesser level.
    ensures: SectionContentReplaced(op, filesystem)
}

rule MarkdownAppendContent {
    -- @status: Implemented
    when: SectionFound(op, filesystem)
    requires: op.append = true

    -- Insert source content at the end of the section, before the
    -- next heading.
    ensures: SectionContentAppended(op, filesystem)
}

-- ==========================================================================
-- XML Merge Semantics
-- ==========================================================================

rule XmlDeepMerge {
    -- @status: Implemented
    when: ApplyXmlMerge(op, filesystem)

    -- Elements merge recursively: source child elements are merged into
    -- the destination by matching on element local name AND namespace URI
    -- (not prefix). Source attributes override destination attributes on
    -- the same element. Destination-only elements and attributes are
    -- preserved. Text content uses last-write-wins.
    ensures: XmlMerged(op, filesystem)

    @guidance
        -- Element matching uses the pair (local name, namespace URI).
        -- Two elements with the same local name but different namespace
        -- URIs are distinct and do not merge into each other.
        -- Namespace declarations are preserved through round-trip. When
        -- merging elements from different namespace contexts, the
        -- necessary namespace declarations are carried along so the
        -- output remains well-formed.
}

rule XmlRepeatedElements {
    -- @status: Implemented
    when: XmlMergeChildren(source_children, dest_children, name, namespace, mode, position)

    -- Repeated sibling elements with the same local name and namespace
    -- act as XML's equivalent of arrays. The unified array merge model
    -- (array_mode + position) applies to these groups.
    ensures:
        if mode = replace:
            -- All destination siblings matching (name, namespace) are
            -- replaced with the source siblings.
            result = replace_siblings(dest_children, source_children, name, namespace)
        if mode = append:
            -- Source siblings are added to the destination group.
            if position = start:
                result = insert_siblings_before(dest_children, source_children, name, namespace)
            else:
                result = insert_siblings_after(dest_children, source_children, name, namespace)
        if mode = append_unique:
            -- Only add source siblings whose text content does not
            -- already appear in any destination sibling of the same name.
            let unique = source_children where text_content(item) not in dest_texts(dest_children, name, namespace)
            if position = start:
                result = insert_siblings_before(dest_children, unique, name, namespace)
            else:
                result = insert_siblings_after(dest_children, unique, name, namespace)
        if mode = merge_by_key:
            -- See ArrayMergeByKey: source siblings replace same-name dest
            -- siblings carrying an equal key attribute (key ?? [name, id]),
            -- in place; keyless siblings fall back to text-content
            -- uniqueness; unmatched siblings are inserted at position.
            result = merge_siblings_by_key_attribute(dest_children, source_children, name, namespace, key, position)

    @guidance
        -- A group is "repeated" when either side has more than one sibling.
        -- Under merge_by_key a lone same-name pair also belongs to the
        -- group whenever either element carries a key attribute: the pair
        -- is a keyed list of one, so a different key keeps the destination
        -- element and adds the source one, and an equal key replaces it in
        -- place, exactly as with several siblings. A lone pair with no key
        -- attribute on either side is a single configuration element and
        -- deep-merges per XmlDeepMerge.
}

rule XmlNamespaceHandling {
    -- @status: Implemented
    when: ApplyXmlMerge(op, filesystem)

    -- Elements are matched by local name AND namespace URI, never by
    -- prefix alone. Namespace declarations (xmlns attributes) are
    -- preserved through the parse-merge-serialize round-trip.
    -- When source elements carry namespace declarations not present
    -- in the destination, those declarations are added to the output.
    ensures: NamespacesPreserved(op, filesystem)

    @guidance
        -- CDATA sections are normalized to text content during parse.
        -- This is a known limitation: the Xot tree model follows the
        -- XML Information Set, which does not distinguish CDATA from
        -- text. Round-tripping a document with CDATA sections will
        -- produce equivalent text nodes in the output.
        --
        -- Comments and processing instructions are preserved in their
        -- original positions within the document.
        --
        -- The XML declaration (<?xml ...?>) may be normalized in
        -- output (e.g., encoding attribute added or version quoted
        -- differently). The semantic content is unchanged.
        --
        -- Path navigation uses dot-notation by element local name,
        -- consistent with YAML, JSON, and TOML merge operators.
        -- Example: "project.dependencies.dependency" navigates into
        -- a <project> root, then <dependencies>, then <dependency>.
        -- This is NOT XPath — it uses the same parse_path() function
        -- as the other structured merge operators.
        --
        -- Empty destination files are created with a minimal XML stub:
        -- an XML declaration and a root element matching the source
        -- document's root element name and namespace.
}

-- ==========================================================================
-- Invariants
-- ==========================================================================

invariant SourceAlwaysWins {
    -- @status: Implemented
    -- When source and destination conflict at the same path, the source
    -- value is always used. No merge mode silently discards source data.
}

invariant MergeNeverCorrupts {
    -- @status: Implemented
    -- A merge operation never produces output that is invalid for the
    -- target format. YAML output is valid YAML, JSON is valid JSON,
    -- TOML is valid TOML, XML is well-formed XML, etc.
}

invariant TrailingNewline {
    -- @status: Implemented
    -- All merge output ends with a trailing newline.
}

-- ==========================================================================
-- Open Questions
-- ==========================================================================

open question "Should INI merge support a case-sensitive key matching option for Linux-native INI files?"
-- @status: Open

open question "Should Markdown merge support regex or fuzzy heading matching as an opt-in?"
-- @status: Open
